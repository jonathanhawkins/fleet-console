{
  "name": "fleet-console",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "**/*.css",
    "lib/transport/sim.worker.ts",
    "components/fleet/component-scene.tsx"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "sim": "tsx sim/server.ts",
    "build": "node scripts/build-isolated.mjs",
    "build:static": "STATIC_EXPORT=1 NEXT_PUBLIC_TRANSPORT=worker node scripts/build-isolated.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "budgets": "node scripts/check-budgets.mjs",
    "e2e": "playwright test && node scripts/check-budgets.mjs",
    "e2e:stress": "playwright test --config playwright.stress.config.ts",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "^5.9.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.185.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^4.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
